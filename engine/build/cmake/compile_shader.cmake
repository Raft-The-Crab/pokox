cmake_minimum_required(VERSION 3.28)

# A failed compile must not leave a stale output that looks current.
foreach(name IN ITEMS POKO_SHADER_SOURCE POKO_SHADER_OUTPUT POKO_SHADER_STAGE POKO_SHADER_COMPILER)
  if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${name}")
  endif()
endforeach()
if(NOT IS_ABSOLUTE "${POKO_SHADER_SOURCE}" OR NOT IS_ABSOLUTE "${POKO_SHADER_OUTPUT}")
  message(FATAL_ERROR "Shader source and output must be absolute paths")
endif()
set(tmp "${POKO_SHADER_OUTPUT}.tmp")
# Check both lexical names and physical paths *before* removing any outputs.
# Existing symlinked parent directories can otherwise hide a source/tool alias.
foreach(protected IN ITEMS POKO_SHADER_SOURCE POKO_SHADER_COMPILER)
  cmake_path(ABSOLUTE_PATH ${protected} NORMALIZE OUTPUT_VARIABLE protected_path)
  if(EXISTS "${${protected}}")
    file(REAL_PATH "${${protected}}" protected_real)
  else()
    set(protected_real "${protected_path}")
  endif()
  foreach(candidate IN ITEMS POKO_SHADER_OUTPUT tmp)
    cmake_path(ABSOLUTE_PATH ${candidate} NORMALIZE OUTPUT_VARIABLE candidate_path)
    if(EXISTS "${${candidate}}")
      file(REAL_PATH "${${candidate}}" candidate_real)
    else()
      set(candidate_real "${candidate_path}")
    endif()
    if(WIN32)
      string(TOLOWER "${protected_path}" protected_path)
      string(TOLOWER "${protected_real}" protected_real)
      string(TOLOWER "${candidate_path}" candidate_path)
      string(TOLOWER "${candidate_real}" candidate_real)
    endif()
    if(protected_path STREQUAL candidate_path OR protected_real STREQUAL candidate_real)
      message(FATAL_ERROR "Shader output must not overwrite the source or compiler")
    endif()
  endforeach()
endforeach()
if(NOT POKO_SHADER_STAGE STREQUAL "vert" AND NOT POKO_SHADER_STAGE STREQUAL "frag")
  message(FATAL_ERROR "Unsupported shader stage: ${POKO_SHADER_STAGE}")
endif()
# Clear old results first, including on failure; shaders with includes are
# explicitly unsupported until real transitive dependency tracking is added.
file(REMOVE "${POKO_SHADER_OUTPUT}" "${tmp}")
if(NOT EXISTS "${POKO_SHADER_SOURCE}" OR NOT EXISTS "${POKO_SHADER_COMPILER}")
  message(FATAL_ERROR "Shader source or host compiler not found")
endif()
file(READ "${POKO_SHADER_SOURCE}" source_text)
# GLSL preprocessing joins escaped newlines and treats comments as whitespace.
# Normalize those before checking directives, preserving comment newlines so
# a block comment cannot hide the start of a later preprocessor line.
string(REPLACE "\\\r\n" "" source_scan "${source_text}")
string(REPLACE "\\\n" "" source_scan "${source_scan}")
while(source_scan MATCHES "(//[^\r\n]*|/\\\*([^*]|\\\*+[^*/])*\\\*+/)")
  set(comment "${CMAKE_MATCH_0}")
  string(REGEX REPLACE "[^\r\n]" " " replacement "${comment}")
  string(REPLACE "${comment}" "${replacement}" source_scan "${source_scan}")
endwhile()
if(source_scan MATCHES "(^|[\r\n])[ \t]*#[ \t]*include([ \t]|[\"<])")
  message(FATAL_ERROR "Shader #include is not supported without dependency tracking")
endif()
get_filename_component(output_dir "${POKO_SHADER_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
execute_process(
  COMMAND "${POKO_SHADER_COMPILER}" -V --target-env vulkan1.1 -S "${POKO_SHADER_STAGE}"
          -o "${tmp}" "${POKO_SHADER_SOURCE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result STREQUAL "0")
  file(REMOVE "${tmp}")
  message(FATAL_ERROR "GLSL compilation failed (${result}):\n${stdout}${stderr}")
endif()
if(NOT EXISTS "${tmp}")
  message(FATAL_ERROR "Shader compiler did not produce an output")
endif()
file(SIZE "${tmp}" bytes)
math(EXPR remainder "${bytes} % 4")
file(READ "${tmp}" magic OFFSET 0 LIMIT 4 HEX)
if(bytes LESS 20 OR NOT remainder EQUAL 0 OR NOT magic STREQUAL "03022307")
  file(REMOVE "${tmp}")
  message(FATAL_ERROR "Compiler output is not a plausible little-endian SPIR-V module")
endif()
file(RENAME "${tmp}" "${POKO_SHADER_OUTPUT}" RESULT rename_error)
if(NOT rename_error STREQUAL "0")
  file(REMOVE "${tmp}")
  message(FATAL_ERROR "Could not publish SPIR-V output: ${rename_error}")
endif()
